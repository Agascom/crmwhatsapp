# ===== Serveur CRM =====
PORT=3000
# Credentials admin (connexion a l'app mobile)
ADMIN_USER=admin
ADMIN_PASSWORD=changez-moi
JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire
# URL publique de VOTRE backend (pour l'enregistrement des webhooks)
PUBLIC_URL=https://crm.votre-domaine.com

# ===== Base de donnees Postgres (Neon) =====
# Copiez la chaine de connexion complete depuis Neon (Project > Connect > Prisma/URI)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ===== OpenWA =====
# URL de l'API OpenWA (sans /api)
OPENWA_URL=http://localhost:2785
# Cle API OpenWA (fichier data/.api-key)
OPENWA_API_KEY=owa_k1_...
# Nom de la session WhatsApp a utiliser (optionnel : sinon premiere session pret)
OPENWA_SESSION_ID=
# Secret utilise pour signer les webhooks (partage avec OpenWA)
WEBHOOK_SECRET=changez-moi-secret-webhook
